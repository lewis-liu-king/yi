<UserControl x:Class="TreeChat.Views.ChatInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TreeChat.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="{StaticResource CardBrush}"
            CornerRadius="4"
            Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Top">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="用户消息"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UserMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                    <StackPanel>
                        <TextBlock Text="AI 回复"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AIReply}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,8,0,0"
            Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                     FontSize="13"
                     Text="{Binding InputMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="60"
                     Background="Transparent"/>

                <Button Grid.Column="1"
                        Content="发送"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendMessage}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>