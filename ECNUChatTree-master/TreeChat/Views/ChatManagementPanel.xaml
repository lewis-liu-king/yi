<UserControl x:Class="TreeChat.Views.ChatManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TreeChat.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300">
    <DockPanel>

        <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="1.33*"/>
                <ColumnDefinition Width="1.33*"/>
                <ColumnDefinition Width="1.33*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="新对话"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateNewChat}"/>

            <Button Grid.Column="1"
                    Style="{StaticResource IconButton}"
                    Command="{Binding SaveChat}"
                    ToolTip="保存">
                <Path Data="M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12A3,3 0 0,1 15,15A3,3 0 0,1 12,18A3,3 0 0,1 9,15A3,3 0 0,1 12,12M12,10A5,5 0 0,0 7,15A5,5 0 0,0 12,20A5,5 0 0,0 17,15A5,5 0 0,0 12,10Z"
                      Fill="{StaticResource TextPrimaryBrush}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"/>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Command="{Binding LoadChat}"
                    ToolTip="读取">
                <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"
                      Fill="{StaticResource TextPrimaryBrush}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"/>
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource IconButton}"
                    Command="{Binding RenameChat}"
                    ToolTip="重命名">
                <Path Data="M14.06,9L15,9.94L13.13,11.81L12.19,10.88L14.06,9M17.66,3C17.41,3 17.17,3.09 16.96,3.26L15.13,5.09L18.91,8.87L20.74,7.04C21.15,6.65 21.15,6 20.74,5.59L18.41,3.26C18.2,3.09 17.93,3 17.66,3M14.25,5.97L12.38,7.84L16.16,11.62L18.03,9.75L14.25,5.97M11.5,8.82L5.81,14.5L5,17.58L8.09,18.38L13.78,12.69L11.5,8.82M5,19H19V21H5V19Z"
                      Fill="{StaticResource TextPrimaryBrush}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"/>
            </Button>
        </Grid>

        <ListBox DockPanel.Dock="Top"
             ItemsSource="{Binding ChatList}"
             FontSize="13"
             SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TreeTitle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>